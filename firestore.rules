rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada documento usa como ID el uid de su dueño: solo esa persona puede usarlo.
    // Cualquier otra coleccion queda denegada porque no tiene una regla que la permita.
    match /form-basic/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
